{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "api",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "functions": {
        "app/main.py": {
          "maxDuration": 300,
          "excludeFiles": "{tests/**,merci.db,outbox/**,.venv/**,.pytest_cache/**}"
        }
      }
    },
    "web": {
      "root": "web",
      "framework": "nextjs"
    },
    "landing": {
      "root": "landing"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": {
            "pre": "crm."
          }
        }
      ],
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": {
            "pre": "merci-crm."
          }
        }
      ],
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "landing"
      }
    }
  ]
}
