# Mode : development (local) ou production (refuse les secrets faibles et les fournisseurs factices)
MODE=development
EXIGER_FOURNISSEURS=true                     # false : production sans Resend ni LinkedIn (e-mails non envoyés)
DATABASE_URL=sqlite:///./merci.db

# Adresses
WEB_URL=http://127.0.0.1:3000                 # liens magiques, logo des e-mails
API_URL_PUBLIQUE=http://127.0.0.1:8010       # liens de désinscription
CORS_ORIGINES=http://127.0.0.1:5500,http://localhost:5500   # landing servie en local
TRUST_PROXY=false                             # true derrière le proxy Render : IP lue dans X-Forwarded-For

# Équipe
ADMIN_EMAIL=valentin@merci.local              # adresse de l'admin du pilote, créé au démarrage
ADMIN_PRENOM=Valentin

# Secrets (production : 32 caractères au moins, valeurs par défaut refusées)
JWT_SECRET=dev-jwt-secret-a-changer-en-production-000
SESSION_JOURS=7
CRON_SECRET=dev-cron-secret
CLE_APP_MERCI=dev-cle-app

# E-mails : vide = boîte locale outbox/
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_EXPEDITEUR=bonjour@exemple.test
EMAIL_EXPEDITEUR_NOM=MERCI
OUTBOX_DIR=outbox

# LinkedIn : factice (défaut) ou connectsafely
LINKEDIN_FOURNISSEUR=factice
# ConnectSafely : secret de signature affiché à la création du webhook.
LINKEDIN_WEBHOOK_SECRET=
CONNECTSAFELY_API_KEY=
CONNECTSAFELY_ACCOUNT_ID=

# Offres d'emploi RSE (optionnel)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# HubSpot : jeton d'app privée (droits lecture et écriture des contacts, companies, deals et du schéma) ;
# vide = synchro factice (journal seulement, rien n'est envoyé)
HUBSPOT_TOKEN=
